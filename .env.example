# Keep these values in the local .env (never commit them). The API token is
# resolved only at request time and is never written to logs or job content.
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
NOTION_API_VERSION=2025-09-03
NOTION_TIMEOUT_SECONDS=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=2
DATABASE_URL=sqlite:///./data/jobscrapper.db
